#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.3"
    }
    defaultPrim = "VICA"
    doc = """Generated from Composed Stage of root layer /tmp/tmpmxi7dt9p/VICA.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_vica_jz7dsjm2/usdex_vica/VICA.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_vica_jz7dsjm2/temp_vica/vica.usd
"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "VICA" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    prepend rel isaac:physics:robotJoints = [
        </VICA/Physics/base_footprint_joint>,
        </VICA/Physics/left_wheel_joint>,
        </VICA/Physics/right_wheel_joint>,
        </VICA/Physics/front_right_caster_steer_joint>,
        </VICA/Physics/front_left_caster_steer_joint>,
        </VICA/Physics/laser_joint>,
        </VICA/Physics/front_right_caster_wheel_joint>,
        </VICA/Physics/front_left_caster_wheel_joint>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </VICA/Geometry/base_footprint/base_link>,
        </VICA/Geometry/base_footprint/base_link/left_wheel_1>,
        </VICA/Geometry/base_footprint/base_link/right_wheel_1>,
        </VICA/Geometry/base_footprint/base_link/front_right_caster_steer_1>,
        </VICA/Geometry/base_footprint/base_link/front_right_caster_steer_1/front_right_caster_wheel_1>,
        </VICA/Geometry/base_footprint/base_link/front_left_caster_steer_1>,
        </VICA/Geometry/base_footprint/base_link/front_left_caster_steer_1/front_left_caster_wheel_1>,
        </VICA/Geometry/base_footprint/base_link/laser_frame>,
    ]
    token isaac:robotType = "Default"

    over "Geometry"
    {
        over "base_footprint"
        {
            over "base_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "left_wheel_1" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }

                over "right_wheel_1" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }

                over "front_right_caster_steer_1" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "front_right_caster_wheel_1" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                    }
                }

                over "front_left_caster_steer_1" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "front_left_caster_wheel_1" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                    }
                }

                over "laser_frame" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }
            }
        }
    }

    over "Physics"
    {
        over "base_footprint_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "left_wheel_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "right_wheel_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "front_left_caster_wheel_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "front_right_caster_wheel_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "front_right_caster_steer_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "front_left_caster_steer_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "laser_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }
}

