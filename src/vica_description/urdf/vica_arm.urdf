               ROBOTIS's file and are not transcribed: they belong to meshes
               this does not have, and a tensor that does not match the shape
               drawn beside it is worse than an honest approximation. -->
      <inertia ixx="4.4801646750000004e-05" ixy="0" ixz="0" iyy="0.00019249221113500003" iyz="0" izz="0.00019249221113500003"/>
    </inertial>
  </link>
  <joint name="omx_joint3" type="revolute">
    <!-- 0.024 of forward offset is ROBOTIS's; the vertical part is the
           length being adjusted. -->
    <origin rpy="0 0 0" xyz="0.024 0 0.128"/>
    <parent link="omx_link3"/>
    <child link="omx_link4"/>
    <axis xyz="0 1 0"/>
    <limit effort="1.5" lower="-1.5" upper="1.4" velocity="4.82"/>
  </joint>
  <link name="omx_link5">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://vica_description/meshes/omx/link5.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <inertial>
      <origin rpy="0 0 0" xyz="0.063 0 0"/>
      <mass value="0.14327573"/>
      <!-- Solid box about its own centre. The real inertia tensors are in
               ROBOTIS's file and are not transcribed: they belong to meshes
               this does not have, and a tensor that does not match the shape
               drawn beside it is worse than an honest approximation. -->
      <inertia ixx="4.8355558874999997e-05" ixy="0" ixz="0" iyy="0.00021373157022749997" iyz="0" izz="0.00021373157022749997"/>
    </inertial>
  </link>
  <joint name="omx_joint4" type="revolute">
    <origin rpy="0 0 0" xyz="0.124 0.0 0.0"/>
    <parent link="omx_link4"/>
    <child link="omx_link5"/>
    <axis xyz="0 1 0"/>
    <limit effort="1.5" lower="-1.7" upper="1.97" velocity="4.82"/>
  </joint>
  <!-- Two prismatic fingers. ROBOTIS drives the right one as a mimic of the
         left; mimic is expressed here so a controller that honours it gets one
         degree of freedom and one that does not still gets a closing gripper.
         Stroke is 20 to 75 mm at the jaws, which is the -0.010 to 0.019 of
         travel per finger below. -->
  <link name="omx_gripper_left_link">
    <visual>
      <origin rpy="0 0 0" xyz="0.02 0 0"/>
      <geometry>
        <box size="0.04 0.008 0.02"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <inertial>
      <origin rpy="0 0 0" xyz="0.02 0 0"/>
      <mass value="0.012"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="2e-6" iyz="0" izz="2e-6"/>
    </inertial>
  </link>
  <joint name="omx_gripper_left_joint" type="prismatic">
    <origin rpy="0 0 0" xyz="0.081648 0.021 0.0"/>
    <parent link="omx_link5"/>
    <child link="omx_gripper_left_link"/>
    <axis xyz="0 1 0"/>
    <limit effort="1.0" lower="-0.010" upper="0.019" velocity="0.5"/>
  </joint>
  <link name="omx_gripper_right_link">
    <visual>
      <origin rpy="0 0 0" xyz="0.02 0 0"/>
      <geometry>
        <box size="0.04 0.008 0.02"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <inertial>
      <origin rpy="0 0 0" xyz="0.02 0 0"/>
      <mass value="0.012"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="2e-6" iyz="0" izz="2e-6"/>
    </inertial>
  </link>
  <joint name="omx_gripper_right_joint" type="prismatic">
    <origin rpy="0 0 0" xyz="0.081648 -0.021 0"/>
    <parent link="omx_link5"/>
    <child link="omx_gripper_right_link"/>
    <axis xyz="0 -1 0"/>
    <limit effort="1.0" lower="-0.010" upper="0.019" velocity="0.5"/>
    <mimic joint="omx_gripper_left_joint" multiplier="1.0" offset="0.0"/>
  </joint>
  <!-- Where a button gets pressed. -->
  <link name="omx_end_effector_link"/>
  <joint name="omx_end_effector_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0.126 0.0 0.0"/>
    <parent link="omx_link5"/>
    <child link="omx_end_effector_link"/>
  </joint>
</robot>
