  <link name="camera_link">
    <!-- RViz placeholder; Isaac Sim uses its own D455 USD sensor asset. -->
    <!-- 113 g, the D455's datasheet mass.
       Not optional, for the same reason the ultrasonic links say so: with
       merge_fixed_joints off, a link carrying geometry becomes its own rigid
       body, and a rigid body with no inertial gets no mass. PhysX then reports
       "possibly invalid inertia tensor of {1.0, 1.0, 1.0} and a negative mass"
       on every play, and the articulation's mass matrix goes with it. The
       symptom is position dependent and looks like anything but a mass bug:
       at x=-22 the wheels would not turn and the body slid 0.38 m and stopped,
       at x=0 the wheels spun 5050 degrees while the body never moved and sat
       48 mm low with its chassis on the floor. An earlier comment here claimed
       camera_link could get away with having no inertial. It could not. -->
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.113"/>
      <inertia ixx="1.53e-4" ixy="0.0" ixz="0.0" iyy="1.43e-5" iyz="0.0" izz="1.51e-4"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <!-- D455 nominal depth x width x height: 26 x 124 x 29 mm. -->
        <box size="0.026 0.124 0.029"/>
      </geometry>
      <material name="camera_black"/>
    </visual>
  </link>
  <link name="camera_optical_frame"/>
  <!-- The RealSense driver publishes camera_color_optical_frame and
     camera_depth_optical_frame at runtime, so the physical robot's URDF must
     not declare them: two publishers for one frame is a TF fight.

     Isaac runs no driver, so here the URDF is the only thing that can supply
     them, and it has to: the image headers coming out of the Isaac graphs
     carry those frame names, and nvblox subscribes by them.

     Simplification: both sit at camera_link, ignoring the few-centimetre
     baseline between the D455's colour and depth imagers that the real driver
     reports. Harmless for costmaps at this range; check it before trusting
     close-up colour-to-depth registration. -->
  <link name="camera_color_optical_frame"/>
  <link name="camera_depth_optical_frame"/>
