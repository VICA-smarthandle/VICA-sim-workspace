#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.3"
    }
    defaultPrim = "VICA"
    doc = """Generated from Composed Stage of root layer /tmp/tmpjx8ztdgs/VICA.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_vica_ejfkdio0/usdex_vica/VICA.usdc


