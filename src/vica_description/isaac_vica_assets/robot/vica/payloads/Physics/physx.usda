#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.3"
    }
    defaultPrim = "VICA"
    doc = """Generated from Composed Stage of root layer /tmp/tmpl44tt13y/VICA.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_vica_21xbm69r/usdex_vica/VICA.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_vica_21xbm69r/temp_vica/vica.usd


Generated from Composed Stage of root layer robot/vica/payloads/base.usd
"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "VICA"
{
    over "Physics"
    {
        over "left_wheel_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 1145.9156
        }

        over "right_wheel_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 1145.9156
        }

        over "front_left_caster_wheel_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "front_right_caster_wheel_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "front_right_caster_steer_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "front_left_caster_steer_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }
    }
}

