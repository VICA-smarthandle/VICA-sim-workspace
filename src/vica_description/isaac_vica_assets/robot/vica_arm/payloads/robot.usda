#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.3"
    }
    defaultPrim = "VICA"
    doc = """Generated from Composed Stage of root layer /tmp/tmpulbefmmv/VICA.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_vica_arm_2790jkz7/usdex_vica_arm/VICA.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_vica_arm_2790jkz7/temp_vica_arm/vica_arm.usd
"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "VICA" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    prepend rel isaac:physics:robotJoints = [
        </VICA/Physics/left_wheel_joint>,
        </VICA/Physics/right_wheel_joint>,
        </VICA/Physics/front_right_caster_steer_joint>,
        </VICA/Physics/front_left_caster_steer_joint>,
        </VICA/Physics/laser_joint>,
        </VICA/Physics/usonic_front_left_joint>,
        </VICA/Physics/usonic_front_right_joint>,
        </VICA/Physics/camera_joint>,
        </VICA/Physics/arm_riser_joint>,
        </VICA/Physics/front_right_caster_wheel_joint>,
        </VICA/Physics/front_left_caster_wheel_joint>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </VICA/Geometry/base_footprint/base_link>,
        </VICA/Geometry/base_footprint/base_link/left_wheel_1>,
        </VICA/Geometry/base_footprint/base_link/right_wheel_1>,
        </VICA/Geometry/base_footprint/base_link/front_right_caster_steer_1>,
        </VICA/Geometry/base_footprint/base_link/front_right_caster_steer_1/front_right_caster_wheel_1>,
        </VICA/Geometry/base_footprint/base_link/front_left_caster_steer_1>,
        </VICA/Geometry/base_footprint/base_link/front_left_caster_steer_1/front_left_caster_wheel_1>,
        </VICA/Geometry/base_footprint/base_link/laser_frame>,
        </VICA/Geometry/base_footprint/base_link/usonic_front_left>,
        </VICA/Geometry/base_footprint/base_link/usonic_front_right>,
        </VICA/Geometry/base_footprint/base_link/camera_link>,
        </VICA/Geometry/base_footprint/base_link/arm_riser_link>,
    ]
    token isaac:robotType = "Default"

    over "Geometry"
    {
        over "base_footprint"
        {
            over "base_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "left_wheel_1" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }

                over "right_wheel_1" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }

                over "front_right_caster_steer_1" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "front_right_caster_wheel_1" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                    }
                }

                over "front_left_caster_steer_1" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "front_left_caster_wheel_1" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                    }
                }

                over "laser_frame" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }

                over "usonic_front_left" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }

                over "usonic_front_right" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }

                over "camera_link" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "camera_optical_frame" (
                        prepend apiSchemas = ["IsaacSiteAPI"]
                    )
                    {
                    }

                    over "camera_color_optical_frame" (
                        prepend apiSchemas = ["IsaacSiteAPI"]
                    )
                    {
                    }

                    over "camera_depth_optical_frame" (
                        prepend apiSchemas = ["IsaacSiteAPI"]
                    )
                    {
                    }
                }

                over "arm_riser_link" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }
            }
        }
    }

    over "Physics"
    {
        over "left_wheel_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "right_wheel_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "front_left_caster_wheel_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "front_right_caster_wheel_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "front_right_caster_steer_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "front_left_caster_steer_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "laser_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "usonic_front_left_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "usonic_front_right_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "camera_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "arm_riser_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }
}

